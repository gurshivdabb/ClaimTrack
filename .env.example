# Copy this file to .env (same folder) and replace every value. .env is git-ignored; this example
# file is committed, so never put real values here.

# SQL Server's admin password. At least 8 characters with three of: upper case, lower case,
# digits, symbols. Avoid ; " ' and $ (they break the connection string or the shell).
MSSQL_SA_PASSWORD=Change-Me-Strong-Passw0rd

# Signs login tokens. A long random string of at least 32 characters.
JWT_SIGNING_KEY=replace-with-a-long-random-string-of-at-least-32-characters

# Password for every demo account (supervisor@claimtrack.test, alex.martin@claimtrack.test, ...).
# At least 8 characters.
DEMO_PASSWORD=Change-Me-Demo-1
