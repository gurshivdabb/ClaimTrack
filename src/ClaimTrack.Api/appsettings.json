{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Documents": {
    "StoragePath": "App_Data/documents",
    "MaxSizeBytes": 10485760,
    "MaxPerClaim": 20
  },
  "OverdueClaims": {
    "Enabled": true,
    "ThresholdDays": 14,
    "CheckIntervalMinutes": 60
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 5, "WindowSeconds": 60 },
    "General": { "PermitLimit": 100, "WindowSeconds": 60 }
  },
  "Jwt": {
    "Issuer": "ClaimTrack",
    "Audience": "ClaimTrack"
  }
}
